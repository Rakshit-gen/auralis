# The browser calls the API gateway directly in local development.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api

# Optional: for same-origin deployments, Next proxies /api to this internal URL.
# GATEWAY_INTERNAL_URL=http://gateway:8080

# Public site origin, used for absolute URLs in social share cards (Open Graph
# / Twitter). Falls back to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=https://auralis.example.com
