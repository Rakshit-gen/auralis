# Copy to .env before running `make up`. The local defaults are fine for
# development; change every secret before deploying anywhere public.

# --- Secrets (shared by the services) ---
# HMAC secret the auth service signs JWTs with and the gateway verifies.
JWT_SECRET=dev-jwt-secret-change-me-0123456789
# HMAC secret for the gateway->service signed identity headers.
IDENTITY_SECRET=dev-identity-secret-change-me-0123456789
# Shared token for service-to-service calls (ai-media -> content, playback -> user).
SERVICE_SHARED_TOKEN=dev-service-token-change-me-0123456789

# --- Admin bootstrap ---
# On first start the auth service ensures this account exists with the ADMIN,
# CREATOR, and USER roles. The seed script logs in with it.
ADMIN_EMAIL=admin@auralis.local
ADMIN_PASSWORD=auralis-admin-pw

# --- Object storage (MinIO locally) ---
MINIO_ROOT_USER=auralis
MINIO_ROOT_PASSWORD=auralis-secret

# --- Observability ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Web client ---
NEXT_PUBLIC_API_BASE=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI provider (optional) ---
# Leave GROQ_API_KEY empty to use the bundled local generator. Never required.
GROQ_API_KEY=
# auto | local | groq
AI_DEFAULT_PROVIDER=auto

LOG_LEVEL=info
